---
import {
  popularityLabel,
  walkingMinutesFromCenter,
  villageCenter,
  type Place,
} from '../data/places';
import { events } from '../data/events';
import { parks, type Park } from '../data/parks';

interface Props {
  places: Place[];
  className?: string;
  singleZoom?: number;
}

const { places, className = 'h-80', singleZoom = 15 } = Astro.props;

const points = places.map((p) => ({
  slug: p.slug,
  name: p.name,
  town: p.town,
  lat: p.lat,
  lng: p.lng,
  schedule: p.schedule,
  popularity: popularityLabel(p.googleRating),
  walkingMinutes: walkingMinutesFromCenter(p),
}));

// Only events that link to a place are useful for the next-event lookup.
const slimEvents = events
  .filter((e) => e.placeSlug)
  .map((e) => ({
    placeSlug: e.placeSlug!,
    title: e.title,
    start: e.start,
    end: e.end,
    recurring: e.recurring,
  }));

// Parks and the AHET trail only appear on multi-place maps (the home-page view).
const showOverlays = places.length > 1;
const parksToShow: Park[] = showOverlays ? parks : [];
const trailsHref: string | null = showOverlays ? '/trails.geojson' : null;
---

<div
  class:list={['field-guide-map', className]}
  data-points={JSON.stringify(points)}
  data-events={JSON.stringify(slimEvents)}
  data-parks={JSON.stringify(parksToShow)}
  data-trails-href={trailsHref}
  data-single-zoom={singleZoom}
  data-village-center={JSON.stringify(villageCenter)}
  role="region"
  aria-label={places.length === 1 ? `Map of ${places[0].name}` : 'Map of places in the field guide'}
>
</div>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';
  import { isOpenNow, type Schedule } from '../data/places';
  import { expandOccurrences, type FieldEvent } from '../data/events';

  type Point = {
    slug: string;
    name: string;
    town: string;
    lat: number;
    lng: number;
    schedule: Schedule;
    popularity: string | null;
    walkingMinutes: number | null;
  };
  type SlimEvent = Pick<FieldEvent, 'placeSlug' | 'title' | 'start' | 'end' | 'recurring'>;

  function fmtTime12(s: string): string {
    const [h, m] = s.split(':').map(Number);
    const period = h >= 12 ? 'p' : 'a';
    const h12 = h === 0 ? 12 : h > 12 ? h - 12 : h;
    return m === 0 ? `${h12}${period}` : `${h12}:${String(m).padStart(2, '0')}${period}`;
  }

  function fmtDayAndDate(d: Date, todayMidnight: Date): string {
    const dayDiff = Math.round((d.getTime() - todayMidnight.getTime()) / 86400000);
    if (dayDiff === 0) return 'Today';
    if (dayDiff === 1) return 'Tomorrow';
    return d.toLocaleDateString('en-US', {
      weekday: 'short',
      month: 'short',
      day: 'numeric',
    });
  }

  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, (c) =>
      c === '&' ? '&amp;' : c === '<' ? '&lt;' : c === '>' ? '&gt;' : c === '"' ? '&quot;' : '&#39;',
    );
  }

  function buildPopupHtml(
    p: Point,
    eventsForPlace: SlimEvent[],
    now: Date,
    todayMidnight: Date,
    horizon: Date,
  ): string {
    const status = isOpenNow(p.schedule, now);
    let statusHtml = '';
    if (status.open) {
      statusHtml = `<div class="fg-popup-status is-open">Open · until ${fmtTime12(status.closesAt)}</div>`;
    } else if (status.reason === 'appt') {
      statusHtml = `<div class="fg-popup-status is-appt">By appointment</div>`;
    } else {
      // Closed today — only show this if there's nothing further to say.
      // Keep it muted/subtle so it doesn't dominate.
      statusHtml = `<div class="fg-popup-status is-closed">Closed today</div>`;
    }

    let eventHtml = '';
    const occs = eventsForPlace.flatMap((e) =>
      expandOccurrences(e as unknown as FieldEvent, now, horizon),
    );
    occs.sort((a, b) => a.start.getTime() - b.start.getTime());
    const next = occs[0];
    if (next) {
      const day = fmtDayAndDate(next.start, todayMidnight);
      const time = next.allDay ? '' : ` · ${fmtTime12(next.start.toTimeString().slice(0, 5))}`;
      eventHtml = `<div class="fg-popup-event">${escapeHtml(day)} · ${escapeHtml(next.event.title)}${time}</div>`;
    }

    const popularityHtml = p.popularity
      ? `<span class="fg-popup-popularity"> · ${escapeHtml(p.popularity)}</span>`
      : '';
    const walkingHtml =
      p.walkingMinutes !== null
        ? `<div class="fg-popup-walk">${p.walkingMinutes} min walk from the Village Green</div>`
        : '';

    return `
      <a class="fg-popup-link" href="/${p.slug}/">
        <strong>${escapeHtml(p.name)}</strong>
        <span>${escapeHtml(p.town)}${popularityHtml}</span>
        ${statusHtml}
        ${eventHtml}
        ${walkingHtml}
      </a>
    `;
  }

  document.querySelectorAll<HTMLElement>('.field-guide-map').forEach((el) => {
    const points: Point[] = JSON.parse(el.dataset.points ?? '[]');
    const slimEvents: SlimEvent[] = JSON.parse(el.dataset.events ?? '[]');
    const singleZoom = Number(el.dataset.singleZoom ?? 15);
    if (points.length === 0) return;

    const map = L.map(el, {
      zoomControl: true,
      scrollWheelZoom: false,
    });

    L.tileLayer(
      'https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png',
      {
        attribution:
          '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
        subdomains: 'abcd',
        maxZoom: 19,
      },
    ).addTo(map);

    // 24×24 hit zone, 14×14 visual circle — finger-friendly on touch.
    // Per-place icon — class varies by current open status so closed/appt
    // places render dimmed.
    function iconFor(p: Point) {
      const status = isOpenNow(p.schedule, now);
      return L.divIcon({
        className: status.open ? 'fg-marker' : 'fg-marker is-closed',
        html: '',
        iconSize: [24, 24],
        iconAnchor: [12, 12],
        popupAnchor: [0, -10],
      });
    }

    // Trail overlay — drawn first so it sits beneath all markers.
    // Leaflet sets the path color via SVG attribute, which doesn't resolve
    // CSS variables — we apply a className and style via CSS instead.
    const trailsHref = el.dataset.trailsHref;
    if (trailsHref) {
      fetch(trailsHref)
        .then((r) => (r.ok ? r.json() : null))
        .then((geo) => {
          if (!geo) return;
          L.geoJSON(geo, {
            style: {
              className: 'fg-trail',
              weight: 2.5,
              opacity: 0.65,
              dashArray: '4 4',
            },
          }).addTo(map);
        })
        .catch(() => {});
    }

    // Park markers — outlined sage squares, visually distinct from filled
    // place dots. Rendered before place markers so they sit beneath.
    type ParkPoint = { slug: string; name: string; description: string; lat: number; lng: number };
    const parksData: ParkPoint[] = JSON.parse(el.dataset.parks ?? '[]');
    for (const park of parksData) {
      const parkIcon = L.divIcon({
        className: 'fg-marker-park',
        html: '',
        iconSize: [22, 22],
        iconAnchor: [11, 11],
        popupAnchor: [0, -8],
      });
      const desc = park.description ? `<div class="fg-park-desc">${park.description}</div>` : '';
      L.marker([park.lat, park.lng], {
        icon: parkIcon,
        title: park.name,
      })
        .bindPopup(
          `<div class="fg-popup-link"><strong>${park.name}</strong><span>Park</span>${desc}</div>`,
        )
        .addTo(map);
    }

    const now = new Date();
    const todayMidnight = new Date(now);
    todayMidnight.setHours(0, 0, 0, 0);
    const horizon = new Date(now.getTime() + 14 * 24 * 60 * 60 * 1000);

    const eventsByPlace = new Map<string, SlimEvent[]>();
    for (const e of slimEvents) {
      const arr = eventsByPlace.get(e.placeSlug) ?? [];
      arr.push(e);
      eventsByPlace.set(e.placeSlug, arr);
    }

    const markers = points.map((p) => {
      const eventsForPlace = eventsByPlace.get(p.slug) ?? [];
      const html = buildPopupHtml(p, eventsForPlace, now, todayMidnight, horizon);
      return L.marker([p.lat, p.lng], { icon: iconFor(p), title: p.name }).bindPopup(html);
    });
    const group = L.featureGroup(markers).addTo(map);

    if (points.length === 1) {
      map.setView([points[0].lat, points[0].lng], singleZoom);
    } else {
      map.fitBounds(group.getBounds(), { padding: [28, 28] });
    }
  });
</script>

<style is:global>
  .field-guide-map {
    border: 1px solid var(--color-rule);
    background: var(--color-paper);
  }

  /* Transparent 24×24 hit zone wrapping a 14×14 visible dot. */
  .fg-marker {
    background: transparent;
    border: 0;
    position: relative;
  }
  .fg-marker::after {
    content: '';
    position: absolute;
    top: 5px;
    left: 5px;
    width: 14px;
    height: 14px;
    background: var(--color-accent);
    border: 2px solid var(--color-paper);
    border-radius: 9999px;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.18);
    transition: opacity 0.2s, background-color 0.2s;
  }
  /* Currently closed (or by-appointment) places dim to a muted dot so
     open places visually pop. The hit zone is unchanged. */
  .fg-marker.is-closed::after {
    background: var(--color-muted);
    opacity: 0.45;
    box-shadow: none;
  }

  /* Park markers — outlined sage squares. Different shape from place
     dots so the eye reads them as a separate category. */
  .fg-marker-park {
    background: transparent;
    border: 0;
    position: relative;
  }
  .fg-marker-park::after {
    content: '';
    position: absolute;
    top: 4px;
    left: 4px;
    width: 14px;
    height: 14px;
    background: transparent;
    border: 1.5px solid var(--color-accent);
    border-radius: 2px;
    opacity: 0.75;
  }
  .fg-marker-park:hover::after {
    opacity: 1;
  }

  .fg-park-desc {
    margin-top: 6px;
    font-size: 12px;
    color: var(--color-muted);
    line-height: 1.35;
  }

  /* Albany-Hudson Electric Trail overlay (any GeoJSON LineString). */
  .leaflet-overlay-pane svg path.fg-trail {
    stroke: var(--color-accent);
    fill: none;
  }

  .leaflet-container {
    font-family: var(--font-serif);
    background: var(--color-paper);
  }

  .leaflet-popup-content-wrapper {
    background: var(--color-paper);
    color: var(--color-ink);
    border: 1px solid var(--color-rule);
    border-radius: 2px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
  }
  .leaflet-popup-tip {
    background: var(--color-paper);
    border: 1px solid var(--color-rule);
  }
  .leaflet-popup-content {
    margin: 10px 14px;
    line-height: 1.4;
    min-width: 200px;
  }
  .leaflet-popup-content .fg-popup-link {
    text-decoration: none;
    color: var(--color-ink);
    display: block;
  }
  .leaflet-popup-content .fg-popup-link strong {
    display: block;
    font-weight: 500;
    margin-bottom: 2px;
  }
  .leaflet-popup-content .fg-popup-link > span {
    display: block;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-muted);
    font-family: var(--font-sans);
  }
  .leaflet-popup-content .fg-popup-link:hover strong {
    color: var(--color-accent);
  }

  .fg-popup-status {
    display: inline-block;
    margin-top: 6px;
    padding: 2px 7px;
    font-family: var(--font-sans);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border-radius: 1px;
  }
  .fg-popup-status.is-open {
    background: var(--color-accent);
    color: var(--color-paper);
  }
  .fg-popup-status.is-appt,
  .fg-popup-status.is-closed {
    background: transparent;
    color: var(--color-muted);
    border: 1px solid var(--color-rule);
  }

  .fg-popup-event {
    display: block;
    margin-top: 6px;
    font-size: 12px;
    font-style: italic;
    color: var(--color-ink);
    line-height: 1.35;
  }

  .fg-popup-walk {
    display: block;
    margin-top: 4px;
    font-family: var(--font-sans);
    font-size: 11px;
    color: var(--color-muted);
  }

  .fg-popup-popularity {
    font-family: var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .leaflet-control-attribution {
    background: rgba(247, 244, 236, 0.85) !important;
    color: var(--color-muted) !important;
    font-family: var(--font-sans);
    font-size: 10px !important;
  }
  .leaflet-control-attribution a {
    color: var(--color-muted) !important;
  }

  .leaflet-bar a,
  .leaflet-bar a:hover {
    background: var(--color-paper);
    color: var(--color-ink);
    border-color: var(--color-rule);
  }
  .leaflet-bar a:hover {
    color: var(--color-accent);
  }
</style>
