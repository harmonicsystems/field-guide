---
import { render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Map from '../components/Map.astro';
import { places, collectionLD, websiteLD } from '../data/places';
import { events, eventsInRange } from '../data/events';
import { liveNotes, noteDateLabel } from '../data/fieldNotes';

const towns = Array.from(new Set(places.map((p) => p.town)));
const byTown = towns.map((town) => ({
  town,
  items: places.filter((p) => p.town === town),
}));

const siteUrl = Astro.site ?? new URL('https://field-guide.feed-and-seed.com');
const base = siteUrl.toString().replace(/\/$/, '');
const ld = {
  '@context': 'https://schema.org',
  '@graph': [websiteLD(base), collectionLD(places, base)],
};

// Latest field notes (max 5). Section renders only when there are any.
const allNotes = await liveNotes();
const recentNotes = await Promise.all(
  allNotes.slice(0, 5).map(async (note) => ({
    note,
    Content: (await render(note)).Content,
    place: note.data.place ? places.find((p) => p.slug === note.data.place) : undefined,
  })),
);

// This weekend's events, computed at build time (nightly rebuild keeps it
// honest). "This weekend" = the current Sat–Sun if we're in or before it,
// i.e. on a Sunday it means today.
const buildNow = new Date();
const day = buildNow.getDay(); // 0 = Sun
const weekendStart = new Date(buildNow);
weekendStart.setHours(0, 0, 0, 0);
if (day !== 0) weekendStart.setDate(weekendStart.getDate() + ((6 - day) % 7));
const weekendEnd = new Date(weekendStart);
weekendEnd.setDate(weekendEnd.getDate() + (day === 0 ? 0 : 1));
weekendEnd.setHours(23, 59, 59, 999);
const weekendEvents = eventsInRange(events, weekendStart, weekendEnd).slice(0, 6);

function fmtWeekendDate(d: Date): string {
  return d.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
}
function weekendEventPlace(placeSlug: string | undefined): string | null {
  if (!placeSlug) return null;
  return places.find((p) => p.slug === placeSlug)?.name ?? null;
}

// Slim payloads for the status-indicator client script.
const statusSchedules = Object.fromEntries(
  places.map((p) => [p.slug, { schedule: p.schedule, season: p.season ?? null }]),
);
---

<Layout
  title="Kinderhook, NY field guide — what to do, eat, see"
  description="What to do in Kinderhook, NY — restaurants, shops, trails, and events. A curated field guide to Old Kinderhook, Columbia County, and the upper Hudson Valley."
>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(ld)}
  />

  <main class="max-w-2xl mx-auto px-6 py-16">
    <header class="mb-16">
      <p class="font-sans text-xs uppercase tracking-[0.2em] text-[var(--color-muted)] mb-4">
        A field guide
      </p>
      <h1 class="text-4xl md:text-5xl leading-tight mb-4">
        Kinderhook<span class="text-[var(--color-muted)]">,</span> and the
        places near it.
      </h1>
      <p class="text-lg text-[var(--color-muted)] leading-relaxed">
        Kept by Feed &amp; Seed, a barn in Kinderhook, NY. The list is short on
        purpose. Everywhere here is somewhere we'd actually go.
      </p>
    </header>

    <Map places={places} className="h-80 mb-6" />

    <p class="font-sans text-xs uppercase tracking-[0.2em] mb-16 text-[var(--color-muted)] flex flex-wrap gap-x-6 gap-y-2">
      <a href="/open/" class="hover:text-[var(--color-accent)]">What's open today →</a>
      <a href="/calendar/" class="hover:text-[var(--color-accent)]">What's happening →</a>
      <a href="/today/" class="hover:text-[var(--color-accent)]">Larger type →</a>
    </p>

    {
      recentNotes.length > 0 && (
        <section class="mb-16">
          <h2 class="font-sans text-xs uppercase tracking-[0.2em] text-[var(--color-muted)] mb-4 pb-2 border-b border-[var(--color-rule)]">
            Field notes
          </h2>
          <ul class="space-y-6">
            {recentNotes.map(({ note, Content, place }) => (
              <li>
                <p class="font-sans text-xs uppercase tracking-[0.12em] text-[var(--color-muted)] tabular-nums mb-1">
                  {noteDateLabel(note.data.date)}
                  {place && (
                    <>
                      {' · '}
                      <a href={`/${place.slug}/`} class="hover:text-[var(--color-accent)]">
                        {place.name}
                      </a>
                    </>
                  )}
                </p>
                <div class="prose text-[var(--color-ink)] leading-relaxed">
                  <Content />
                </div>
              </li>
            ))}
          </ul>
          <p class="mt-6 font-sans text-xs uppercase tracking-[0.2em] text-[var(--color-muted)]">
            <a href="/notes/" class="hover:text-[var(--color-accent)]">All notes →</a>
          </p>
        </section>
      )
    }

    {
      weekendEvents.length > 0 && (
        <section class="mb-16">
          <h2 class="font-sans text-xs uppercase tracking-[0.2em] text-[var(--color-muted)] mb-4 pb-2 border-b border-[var(--color-rule)]">
            This weekend
          </h2>
          <ul class="space-y-3">
            {weekendEvents.map((occ) => (
              <li>
                <a
                  href={occ.event.url ?? '/calendar/'}
                  class="block hover:text-[var(--color-accent)] transition-colors"
                >
                  <div class="font-sans text-xs uppercase tracking-[0.12em] text-[var(--color-muted)] tabular-nums">
                    {fmtWeekendDate(occ.start)}
                    {weekendEventPlace(occ.event.placeSlug) && (
                      <> · {weekendEventPlace(occ.event.placeSlug)}</>
                    )}
                  </div>
                  <div class="text-base mt-1">{occ.event.title}</div>
                </a>
              </li>
            ))}
          </ul>
          <p class="mt-6 font-sans text-xs uppercase tracking-[0.2em] text-[var(--color-muted)]">
            <a href="/open/" class="hover:text-[var(--color-accent)]">Weekend hours →</a>
          </p>
        </section>
      )
    }

    {
      byTown.map(({ town, items }) => (
        <section class="mb-12">
          <h2 class="font-sans text-xs uppercase tracking-[0.2em] text-[var(--color-muted)] mb-4 pb-2 border-b border-[var(--color-rule)]">
            {town}
          </h2>
          <ul class="space-y-3">
            {items.map((p) => (
              <li data-slug={p.slug}>
                <a
                  href={`/${p.slug}/`}
                  class="block hover:text-[var(--color-accent)] transition-colors"
                >
                  <div class="flex items-baseline justify-between gap-4">
                    <span class="text-lg flex items-baseline gap-2">
                      <span>{p.name}</span>
                      <span
                        class="status-event-dot hidden"
                        data-status-event
                        aria-label="Event today"
                        title="Event today"
                      />
                    </span>
                    <span class="flex items-baseline gap-3 shrink-0">
                      <span
                        class="status-open-badge hidden font-sans text-[11px] uppercase tracking-[0.12em] tabular-nums"
                        data-status-open
                      />
                      <span class="font-sans text-xs text-[var(--color-muted)] tabular-nums">
                        {p.category.split(' — ')[0]}
                      </span>
                    </span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <footer class="mt-24 pt-8 border-t border-[var(--color-rule)] font-sans text-sm text-[var(--color-muted)]">
      <p>
        A project of
        <a
          href="https://feed-and-seed.com"
          class="underline decoration-[var(--color-rule)]">Feed &amp; Seed</a
        >, a barn in Kinderhook, NY.
      </p>
    </footer>

    <script type="application/json" id="status-schedules" is:inline set:html={JSON.stringify(statusSchedules)} />
    <script type="application/json" id="status-events" is:inline set:html={JSON.stringify(events)} />
  </main>
</Layout>

<script>
  import { isOpenNow, type Schedule, type Season } from '../data/places';
  import { eventsInRange, type FieldEvent } from '../data/events';

  const schedules: Record<string, { schedule: Schedule; season: Season | null }> = JSON.parse(
    document.getElementById('status-schedules')!.textContent || '{}',
  );
  const allEvents: FieldEvent[] = JSON.parse(
    document.getElementById('status-events')!.textContent || '[]',
  );

  const now = new Date();
  const startOfToday = new Date(now);
  startOfToday.setHours(0, 0, 0, 0);
  const endOfToday = new Date(now);
  endOfToday.setHours(23, 59, 59, 999);

  // Build a set of place slugs with an event today.
  const placesWithEventToday = new Set<string>();
  for (const occ of eventsInRange(allEvents, startOfToday, endOfToday)) {
    if (occ.event.placeSlug) placesWithEventToday.add(occ.event.placeSlug);
  }

  function fmtCloseTime(s: string): string {
    const [h, m] = s.split(':').map(Number);
    const period = h >= 12 ? 'p' : 'a';
    const h12 = h === 0 ? 12 : h > 12 ? h - 12 : h;
    return m === 0 ? `${h12}${period}` : `${h12}:${String(m).padStart(2, '0')}${period}`;
  }

  document.querySelectorAll<HTMLElement>('li[data-slug]').forEach((li) => {
    const slug = li.dataset.slug!;
    const entry = schedules[slug];
    if (entry) {
      const status = isOpenNow(entry.schedule, now, entry.season);
      if (status.open) {
        const badge = li.querySelector<HTMLElement>('[data-status-open]');
        if (badge) {
          badge.textContent = `Open · until ${fmtCloseTime(status.closesAt)}`;
          badge.classList.remove('hidden');
          badge.classList.add('is-open');
        }
      }
    }
    if (placesWithEventToday.has(slug)) {
      const dot = li.querySelector<HTMLElement>('[data-status-event]');
      if (dot) dot.classList.remove('hidden');
    }
  });
</script>

<style>
  .status-open-badge {
    color: var(--color-paper);
    background: var(--color-accent);
    padding: 1px 6px;
    border-radius: 1px;
    white-space: nowrap;
  }
  .status-event-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: var(--color-accent);
    transform: translateY(-1px);
  }
  .status-event-dot.hidden,
  .status-open-badge.hidden {
    display: none;
  }
</style>
